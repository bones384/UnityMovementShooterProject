.overhead-root {
    align-items: center;
    justify-content: flex-end;
    width: 800px;
    height: 400px;
}

#player-name {
    font-size: 128px;
    -unity-font-style: bold;
    color: white;
    -unity-text-outline-width: 8px;
    -unity-text-outline-color: black;
    margin-bottom: 24px;
}

.health-bg {
    width: 600px;
    height: 64px;
    background-color: rgba(40, 40, 40, 0.8);
    border-radius: 16px;
    border-width: 8px;
    border-color: black;
    overflow: hidden;
}

#health-fill {
    width: 100%;
    height: 100%;
    background-color: rgb(220, 220, 220);
    transition-property: width;
    transition-duration: 0.1s;
}
#health-text-overhead {
    position: absolute;
    width: 100%;
    height: 100%;
    -unity-text-align: middle-center;
    color: white;
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: black;
}