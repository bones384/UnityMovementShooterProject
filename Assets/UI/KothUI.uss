.koth-root {
    position: absolute;
    top: 20px;
    width: 100%;
    align-items: center;
}

.timers-row {
    flex-direction: row;
    align-items: center;
}

.team-timer {
    font-size: 36px;
    color: white;
    margin-left: 20px;
    margin-right: 20px;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: black;
    text-shadow: 2px 2px 0 rgb(0, 0, 0);
}

.timer-blue {
    background-color: rgba(30, 80, 200, 0.5);
    padding: 5px 15px;
    border-radius: 8px;
}

.timer-red {
    background-color: rgba(200, 40, 40, 0.5);
    padding: 5px 15px;
    border-radius: 8px;
}

/* Bold class used dynamically via C# for 0:00 */
.timer-zero {
    -unity-font-style: bold;
    color: rgb(255, 200, 0);
}

#point-square {
    width: 64px;
    height: 64px;
    border-radius: 12px;
    background-color: rgb(100, 100, 100);
    border-width: 4px;
    border-color: rgb(30, 30, 30);
    overflow: hidden;
    justify-content: center;
    align-items: center;
}

#point-fill {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 0%; /* Driven by code */
    background-color: white;
}

#point-status-text {
    font-size: 28px;
    -unity-font-style: bold;
    color: white;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: black;
}

#overtime-label {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(255, 200, 0);
    background-color: rgba(0, 0, 0, 0.7);
    padding: 2px 10px;
    border-radius: 4px;
    margin-top: 10px;
    display: none; /* Hidden by default */
}

/* --- VICTORY SCREEN --- */
#victory-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    display: none; /* Hidden during standard gameplay */
}

#victory-box {
    padding: 40px 100px;
    border-radius: 24px;
    border-width: 6px;
    border-color: rgba(255, 255, 255, 0.4);
}

.victory-blue {
    background-color: rgba(30, 80, 200, 0.85);
}

.victory-red {
    background-color: rgba(200, 40, 40, 0.85);
}

#victory-box {
    padding: 40px 100px;
    border-radius: 24px;
    border-width: 6px;
    border-color: rgba(255, 255, 255, 0.4);
    /* NEW: Force the box to tightly align its inner contents */
    align-items: center;
    justify-content: center;
}

#victory-text {
    font-size: 112px;
    -unity-font-style: bold;
    color: white;
    -unity-text-outline-width: 4px;
    -unity-text-outline-color: black;
    text-shadow: 4px 4px 0 rgb(0, 0, 0);
    /* NEW: Stop the text from wrapping, and explicitly center it */
    white-space: nowrap;
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}