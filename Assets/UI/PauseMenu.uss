.pause-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.7);
    align-items: center;
    justify-content: center;
}

.pause-box {
    background-color: rgb(35, 35, 40);
    border-radius: 12px;
    padding: 40px;
    width: 400px;
    align-items: center;
    border-width: 2px;
    border-color: rgb(70, 70, 75);
}

.pause-title {
    font-size: 48px;
    -unity-font-style: bold;
    color: white;
    margin-bottom: 40px;
    letter-spacing: 5px;
}

.pause-button {
    width: 100%;
    height: 60px;
    font-size: 24px;
    -unity-font-style: bold;
    color: white;
    background-color: rgb(50, 50, 55);
    border-radius: 8px;
    border-width: 0;
    margin-bottom: 20px;
    transition-duration: 0.1s;
}

.pause-button:hover { background-color: rgb(80, 80, 85); scale: 1.05; }
.quit-button { background-color: rgb(150, 40, 40); }
.quit-button:hover { background-color: rgb(200, 50, 50); }