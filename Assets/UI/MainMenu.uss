.main-container {
    flex-grow: 1;
    background-color: rgb(30, 30, 35);
    align-items: center;
    justify-content: center;
}

.title-text {
    font-size: 80px;
    -unity-font-style: bold;
    color: white;
    margin-bottom: 60px;
    text-shadow: 2px 4px 0 rgba(0, 0, 0, 0.5);
}

.button-container {
    width: 350px;
}

.menu-button {
    height: 60px;
    font-size: 24px;
    -unity-font-style: bold;
    color: white;
    background-color: rgb(0, 120, 215);
    border-radius: 8px;
    border-width: 0;
    margin-bottom: 20px;
    transition-duration: 0.1s;
}

.menu-button:hover {
    background-color: rgb(0, 150, 255);
    scale: 1.05;
}

.exit-button {
    background-color: rgb(150, 40, 40);
}

.exit-button:hover {
    background-color: rgb(200, 50, 50);
}

.cancel-button {
    background-color: rgb(100, 100, 100);
}

.cancel-button:hover {
    background-color: rgb(130, 130, 130);
}

.popup-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.85);
    align-items: center;
    justify-content: center;
}

.popup-box {
    background-color: rgb(40, 40, 45);
    border-radius: 12px;
    padding: 40px;
    width: 500px;
    align-items: center;
    border-width: 2px;
    border-color: rgb(70, 70, 75);
}

.popup-title {
    font-size: 32px;
    -unity-font-style: bold;
    color: white;
    margin-bottom: 20px;
}

.popup-status {
    font-size: 18px;
    color: rgb(200, 200, 200);
    margin-bottom: 40px;
    -unity-text-align: middle-center;
}

.welcome-text {
    font-size: 24px;
    color: rgb(200, 200, 200);
    margin-bottom: 20px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.login-button {
    background-color: rgb(40, 180, 80);
}

.login-button:hover {
    background-color: rgb(50, 210, 100);
}

.username-input {
    margin-bottom: 20px;
}

.username-input > .unity-text-field__label {
    color: white;
    -unity-font-style: bold;
    font-size: 16px;
    min-width: 100px;
}

.username-input > .unity-text-field__input {
    background-color: rgb(20, 20, 25);
    color: white;
    font-size: 20px;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(80, 80, 85);
    padding: 10px;
}