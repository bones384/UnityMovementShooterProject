:root {

}

.hud-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    position: absolute;
}

#crosshair {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 6px;
    height: 6px;
    translate: -50% -50%;
    background-color: white;
    border-radius: 3px;
}

#abilities-container {
    position: absolute;
    bottom: 30px;
    width: 100%;
    flex-direction: row;
    justify-content: center;
    align-items: flex-end;
}

.ability-slot {
    width: 64px;
    height: 64px;
    margin-left: 10px;
    margin-right: 10px;
    background-color: rgb(80, 80, 80);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgb(40, 40, 40);
    overflow: hidden;
}

.ability-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.75);
    justify-content: center;
    align-items: center;
    display: none;
}

.ability-timer {
    color: white;
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-shadow: 1px 1px 0 rgb(0, 0, 0);
}

#health-container {
    position: absolute;
    bottom: 30px;
    right: 40px;
    width: 300px;
}

#health-text {
    color: white;
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: lower-right;
    margin-bottom: 5px;
    text-shadow: 1px 1px 0 rgb(0, 0, 0);
}

#health-bar-bg {
    width: 100%;
    height: 24px;
    background-color: rgb(40, 40, 40);
    border-radius: 4px;
    border-width: 2px;
    border-color: rgb(20, 20, 20);
    overflow: hidden;
}

#health-bar-fill {
    width: 100%;
    height: 100%;
    background-color: rgb(220, 50, 50);
    transition-duration: 0.1s;
    transition-timing-function: ease-out;
}

.death-screen {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(100, 0, 0, 0.4);
    justify-content: center;
    align-items: center;
    display: none;
}

.death-title {
    font-size: 96px;
    -unity-font-style: bold;
    color: rgb(255, 50, 50);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: black;
}

.death-subtitle {
    font-size: 48px;
    color: white;
    margin-top: 10px;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: black;
}

.killfeed-container {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 400px;
    flex-direction: column;
    align-items: flex-end;
}

.killfeed-row {
    flex-direction: row;
    align-items: center;
    background-color: rgba(235, 226, 202, 0.85);
    border-radius: 4px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0.5);
    padding: 4px 12px;
    margin-bottom: 4px;
    transition-property: opacity;
    transition-duration: 0.25s;
}

.killfeed-text {
    color: rgb(40, 40, 40);
    font-size: 18px;
    -unity-font-style: bold;
}

.killfeed-icon {
    width: 32px;
    height: 32px;
    margin-left: 8px;
    margin-right: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

.primary-ability-wrapper {
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
}

.ammo-label {
    color: white;
    font-size: 20px;
    -unity-font-style: bold;
    text-shadow: 1px 1px 0 rgb(0, 0, 0);
    margin-bottom: 4px;
}

.hitmarker {
    position: absolute;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    display: none;
}

.hitmarker-line {
    position: absolute;
    background-color: white;
    width: 3px;
    height: 14px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.85);
}

.hitmarker-tl {
    translate: -12px -12px;
    rotate: -45deg;
}

.hitmarker-tr {
    translate: 12px -12px;
    rotate: 45deg;
}

.hitmarker-bl {
    translate: -12px 12px;
    rotate: 45deg;
}

.hitmarker-br {
    translate: 12px 12px;
    rotate: -45deg;
}

.hitmarker-fatal .hitmarker-line {
    background-color: rgb(255, 50, 50);
    width: 5px;
    height: 18px;
}